# ===============================
#    SISTEMA DE GESTIÓN LÁCTEA
#    FRONT CONTROLLER (php-src)
# ===============================

RewriteEngine On
RewriteBase /Compra-y-Gestion-de-Leche/php-src/

# ----------------------------------------------
# 1) Permitir acceso a archivos y carpetas reales
# ----------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ----------------------------------------------
# 2) Redirigir TODO al front controller (index.php)
# ----------------------------------------------
RewriteRule ^ index.php [QSA,L]


# =========================================================
#     SEGURIDAD REPARADA (NO BLOQUEAR LAS VISTAS PHP)
# =========================================================

Options -Indexes

# 🔒 Bloquear acceso directo a includes, PERO permitir include desde PHP
# (IMPORTANTE: no aplicar a todo php-src, solo includes/)
RewriteRule ^includes/(.*)$ - [F]

# 🔓 PERMITIR todos los .php para que PHP los incluya internamente
# (si no, el router NO podrá cargar panel_productor.php)
<FilesMatch "\.php$">
    Require all granted
</FilesMatch>

# 🔓 EXCEPCIÓN: permitir index.php (router)
<Files "index.php">
    Require all granted
</Files>


# =================================
# CACHE - (se mantiene todo)
# =================================
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>


# ===============================
# COMPRESIÓN GZIP (se mantiene)
# ===============================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css application/json \
    application/javascript application/xml application/xhtml+xml image/svg+xml
</IfModule>


# ===============================
#    HEADERS DE SEGURIDAD
# ===============================
<IfModule mod_headers.c>
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
</IfModule>


# ===============================
#    MANEJO DE ERRORES
# ===============================
ErrorDocument 404 /Compra-y-Gestion-de-Leche/php-src/index.php
ErrorDocument 403 /Compra-y-Gestion-de-Leche/php-src/index.php
ErrorDocument 500 /Compra-y-Gestion-de-Leche/php-src/index.php
